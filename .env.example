VITE_FIREBASE_PROJECT_ID=ditado-inteligente
VITE_FIREBASE_STORAGE_BUCKET=ditado-inteligente.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=835428534377
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
