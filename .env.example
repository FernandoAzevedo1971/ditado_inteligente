GROQ_API_KEY=

# Provedor de transcrição de áudio: "groq" (padrão, Whisper large-v3) ou
# "voxtral" (Mistral Voxtral, requer VOXTRAL_API_KEY abaixo)
TRANSCRIPTION_PROVIDER=groq
VOXTRAL_API_KEY=

NODE_ENV=development

# Firebase Config (Copy from Firebase Console)
VITE_FIREBASE_API_KEY=
